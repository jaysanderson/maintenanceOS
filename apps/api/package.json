{
  "name": "@maintenanceos/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "PORT=4010 node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push --skip-generate && prisma generate && tsx prisma/seed.ts",
    "arag:sync": "node --env-file-if-exists=.env --import tsx scripts/arag-sync.ts",
    "arag:enrich": "node --env-file-if-exists=.env --import tsx scripts/arag-enrich.ts",
    "arag:provision-agent": "node --env-file-if-exists=.env --import tsx scripts/arag-provision-agent.ts",
    "spike:vision": "node --env-file-if-exists=.env --import tsx scripts/spike-vision-extract.ts",
    "arag:provision-extract": "node --env-file-if-exists=.env --import tsx scripts/arag-provision-extract.ts",
    "arag:ingest-guide": "node --env-file-if-exists=.env --import tsx scripts/ingest-user-guide.ts",
    "arag:ingest-finance-policy": "node --env-file-if-exists=.env --import tsx scripts/ingest-finance-policy.ts",
    "arag:ingest-manuals": "node --env-file-if-exists=.env --import tsx scripts/ingest-equipment-manuals.ts",
    "gen:sample-invoice": "node --import tsx scripts/gen-sample-invoice.ts",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@maintenanceos/arag-client": "*",
    "@maintenanceos/mcp-core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^2.1.0",
    "pdfkit": "^0.15.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/pdfkit": "^0.13.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
